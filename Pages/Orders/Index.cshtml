@page
@model Poiect_cafea.Pages.Orders.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Client)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Coffee)
            </th>
            <th>
                @Html.DisplayNameFor(model =>model.Order[0].Coffee.Producer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Coffee.Origin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].ShippingDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Order) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Client.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Coffee.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Coffee.Producer.ProducerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Coffee.Origin.OriginName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ShippingDate)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
